{
  "name": "@local/lt-team",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent product-manager, QA, and rank/api programmer sessions for dsh-superagent workers",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cli": "./cli.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "lt-team": "./cli.js"
  },
  "files": [
    "index.js",
    "cli.js",
    "cordis.patch.yml",
    "lib/*.js",
    "skills/*.md",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "for file in index.js cli.js lib/*.js; do node --check \"$file\" || exit 1; done && node --test"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
